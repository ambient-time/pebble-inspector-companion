    <application android:name=".SignalApplication" android:label="Signal Station" android:icon="@mipmap/ic_launcher" android:allowBackup="false" android:fullBackupContent="@xml/inspector_backup_rules" android:dataExtractionRules="@xml/inspector_data_extraction_rules" android:supportsRtl="true" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:usesCleartextTraffic="false">
